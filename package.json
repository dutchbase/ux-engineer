{
  "name": "ux-engineer",
  "version": "0.5.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ux-engineer": "cli/ux-engineer.mjs"
  },
  "files": [
    "cli/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-shared.ts",
    "validate": "node src/cli.ts validate",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/ux.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.8.0"
  }
}
