{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dutchbase/ux-engineer/schemas/checks.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "required", "result", "evidence_ids"],
        "properties": {
          "check_id": {"type": "string"},
          "required": {"type": "boolean"},
          "result": {"enum": ["pass", "fail", "not_run", "not_applicable"]},
          "not_applicable_reason": {"type": "string"},
          "actual_result": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
